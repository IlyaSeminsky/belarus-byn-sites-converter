{
  "name": "byn-price-converter",
  "version": "2.0.0",
  "description": "Shows the USD/EUR equivalent under BYN prices on kufar.by and av.by, using official NBRB rates.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs --prod",
    "dev": "node build.mjs --watch",
    "zip": "npm run build && node zip.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.4.0",
    "esbuild": "^0.23.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
